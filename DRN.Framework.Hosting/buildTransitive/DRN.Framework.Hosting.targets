<Project>
  <ItemGroup>
    <CompilerVisibleProperty Include="UsingMicrosoftNETSdkWeb" />
  </ItemGroup>
  <!-- Project references do not carry analyzer items. The repository's common import
       supplies the generator to project consumers, including transitive ones. -->
  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'
                        and '$(MSBuildProjectName)' != 'DRN.Framework.Hosting.Generators'
                        and '$(MSBuildProjectName)' != 'DRN.Test.Analyzer'
                        and Exists('$(MSBuildThisFileDirectory)../../DRN.Framework.Hosting.Generators/DRN.Framework.Hosting.Generators.csproj')">
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../DRN.Framework.Hosting.Generators/DRN.Framework.Hosting.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false"
                      UndefineProperties="RuntimeIdentifier;TargetArchitecture;PlatformTarget;SelfContained;PublishReadyToRun" />
  </ItemGroup>
  <PropertyGroup>
    <_DrnHostingPackagedGenerator>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../analyzers/dotnet/cs/DRN.Framework.Hosting.Generators.dll'))</_DrnHostingPackagedGenerator>
  </PropertyGroup>
  <!-- buildTransitive keeps this asset available even when analyzers on an intermediate
       PackageReference are private. Explicit ExcludeAssets=buildTransitive still opts out. -->
  <Target Name="DrnHostingAddPackagedGenerator" BeforeTargets="CoreCompile"
          Condition="'$(MSBuildProjectExtension)' == '.csproj' and Exists('$(_DrnHostingPackagedGenerator)')">
    <ItemGroup>
      <Analyzer Remove="$(_DrnHostingPackagedGenerator)" />
      <Analyzer Include="$(_DrnHostingPackagedGenerator)" />
    </ItemGroup>
  </Target>
  <Import Project="$(MSBuildThisFileDirectory)../buildMultiTargeting/DRN.Framework.Hosting.targets"
          Condition="Exists('$(MSBuildThisFileDirectory)../buildMultiTargeting/DRN.Framework.Hosting.targets')" />

  <PropertyGroup>
    <DrnHostingViteManifestPublishItemsEnabled Condition="'$(DrnHostingViteManifestPublishItemsEnabled)' == ''">true</DrnHostingViteManifestPublishItemsEnabled>
  </PropertyGroup>

  <Target Name="DrnHostingIncludeViteManifestPublishItems"
          BeforeTargets="AssignTargetPaths;GetCopyToPublishDirectoryItems;ComputeFilesToPublish"
          Condition="'$(UsingMicrosoftNETSdkWeb)' == 'true' and '$(DrnHostingViteManifestPublishItemsEnabled)' == 'true'">
    <ItemGroup>
      <_DrnHostingViteManifestPublishFile Include="$(MSBuildProjectDirectory)/wwwroot/**/.vite/manifest.json"
                                           Exclude="@(Content->'%(FullPath)')" />
      <!-- Leave Link/TargetPath unset so the Web SDK assigns the project-relative path and preserves .vite once. -->
      <Content Include="@(_DrnHostingViteManifestPublishFile)"
               CopyToOutputDirectory="PreserveNewest"
               CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
