*.key
*.keys
*.priv
*.rsa
*.key.json
*.ssh
*.ssh-key

# CMake generated files
cmake*.*

# Editor directories and files
*.ntvs*
*.njsproj
*.sln
*.sw?

# Agent-generated process artifacts (should never be committed)
CLARIFY-*.md
DEVELOP-*.md

# Windows-only command scripts are excluded to preserve cross-platform tooling.
*.bat
*.cmd

# Windows credential locations without a hidden parent
**/AppData/Roaming/gcloud/
**/AppData/Roaming/terraform.d/

# Local Kubernetes credentials
kubeconfig
kubeconfig.*
*.kubeconfig

# Generated analysis output
/trivy-results.sarif
