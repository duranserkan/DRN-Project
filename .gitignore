# Hidden files and directories are ignored by default, at every depth.
# Whitelist new shared configuration explicitly, including its hidden parents.
.*
!/.agent/
!/.github/
!/.config/
/.config/*
!/.config/dotnet-tools.json
!.gitignore
!.dockerignore
!.gitattributes
!.editorconfig
!.coderabbit.yaml
!.sample-env
!/Sample.Hosted/.npmrc
!/DRN.Nexus.Hosted/.npmrc
!**/wwwroot/**/.vite/
**/wwwroot/**/.vite/*
!**/wwwroot/**/.vite/manifest.json

# Whitelisting a folder permits its non-hidden contents unless another rule excludes them.
# Existing tracked files are unaffected by ignore rules.
# Non-hidden build output and credential files use the exclusions below.

# Tooling exclusions adapted from https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.env

# Agent workflow state
.agent/temp/*
!.agent/temp/.gitkeep

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
[Bb]in/

x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
[Aa][Rr][Mm]64[Ee][Cc]/
bld/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/

# Visual Studio 2017 auto generated files
Generated\ Files/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Approval Tests result files
*.received.*

