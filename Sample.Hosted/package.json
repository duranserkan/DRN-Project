{
  "name": "sample.hosted",
  "private": true,
  "version": "0.10.1",
  "//": "Dependency versions are pinned exactly to prevent supply chain attacks and guarantee reproducible builds.",
  "engines": {
    "node": "26.13.0"
  },
  "//test": "The unit runner discovers .test.js and .test.ts files recursively. Playwright .spec.js/.spec.ts files run via test:browser. TypeScript execution does not type-check tests.",
  "scripts": {
    "build:test:all": "npm run build && npm run test:all",
    "test": "node buildwww/tests/run-tests.ts --default-pattern \"buildwww/tests/**/*.test.{js,ts}\"",
    "test:all": "npm test -- --browser",
    "test:coverage": "npm test -- --coverage",
    "test:browser": "npm run test:browser:install && playwright test",
    "test:browser:install": "playwright install --only-shell chromium",
    "test:browser:hosted": "playwright install --only-shell chromium && playwright test --config buildwww/tests/hosted/playwright.config.ts",
    "test:browser:serve": "vite --config buildwww/tests/browser/vite.config.ts",
    "format": "oxfmt --write buildwww vite.config.ts vite.config.plugin.ts playwright.config.ts",
    "format:check": "oxfmt --check buildwww vite.config.ts vite.config.plugin.ts playwright.config.ts",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives buildwww vite.config.ts vite.config.plugin.ts playwright.config.ts",
    "lint:styles": "stylelint \"buildwww/**/*.{css,scss}\" --max-warnings 0",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.tests.json",
    "check": "npm run format:check && npm run lint && npm run lint:styles && npm run type-check && npm run check:unused -- --no-exit-code",
    "check:unused": "BUILD_TYPE=app knip",
    "build": "npm run check && npm run build:app && npm run build:appPostload && npm run build:htmx && npm run build:bootstrap && npm run build:react && npm run build:behaviors",
    "build:app": "BUILD_TYPE=app vite build",
    "build:appPostload": "BUILD_TYPE=appPostload vite build",
    "build:behaviors": "npm run build:behaviors:layout && npm run build:behaviors:home && npm run build:behaviors:test",
    "build:behaviors:layout": "BUILD_TYPE=layoutBehaviors vite build",
    "build:behaviors:home": "BUILD_TYPE=homeBehaviors vite build",
    "build:behaviors:test": "BUILD_TYPE=testBehaviors vite build",
    "build:htmx": "BUILD_TYPE=htmx vite build",
    "build:bootstrap": "BUILD_TYPE=bootstrap vite build",
    "build:react": "BUILD_TYPE=react vite build"
  },
  "type": "module",
  "dependencies": {
    "htmx.org": "2.0.11",
    "onmount": "2.0.0",
    "bootstrap": "5.3.8",
    "bootstrap-icons": "1.13.2",
    "@popperjs/core": "2.11.8",
    "aspnet-client-validation": "0.11.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "knip": "6.44.2",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "rolldown": "1.2.16",
    "typescript": "7.0.2",
    "sass-embedded": "1.108.1",
    "stylelint": "17.16.0",
    "stylelint-config-recommended": "18.0.0",
    "stylelint-config-recommended-scss": "17.0.1",
    "vite": "8.3.6",
    "@tailwindcss/vite": "4.3.5",
    "@vitejs/plugin-react": "6.2.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/bootstrap": "5.2.11",
    "@playwright/test": "1.65.0",
    "@axe-core/playwright": "4.14.0"
  }
}
