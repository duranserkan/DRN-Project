@page "/"
@model Sample.Hosted.Pages.HomeAnonymous

@* ────────────────────────────────────────────────────────────────
   TODO: Mounted Islands Architecture Roadmap
   ────────────────────────────────────────────────────────────────

   Boundaries (do NOT do until the trigger is met):
   [ ] Don't split islands into independently deployed framework runtimes or remote modules until a second team or framework exists
   [ ] Don't load heavy frameworks for pages that only need a toggle or counter, use htmx + vanilla JS

   Evolution triggers:
   [ ] Mounted islands grow beyond ~5-6 components with shared state → add a lightweight cross-island state bus
   [ ] Bundle size becomes a concern → lazy-load registry entries with dynamic import()
   [ ] High-performance isolated islands required → Implement Svelte 5 or Vue Vapor mode mount registries
   [ ] Multiple frameworks need to coexist (React + Vue + Svelte) → invest in full micro-frontend separation

   ────────────────────────────────────────────────────────────────  *@

@{
    var pkg = PackageVersions.Instance;
    var options = Get.LayoutOptions.Centered("Welcome");
    
    ViewData[Get.ViewDataKeys.MainContentLayoutOptions] = options;
    options.CenterVertically = false;
    options.ColumnSize = BootstrapColumnSize.None;
    options.Type = MainContentType.None;
    var versions = Json.Serialize(new { dotnet = pkg.Dotnet, react = pkg.React, bootstrap = pkg.Bootstrap, tailwind = pkg.Tailwind, vite = pkg.Vite }).ToString();
}

<div class="text-center py-2">
    <h1 class="h2 fw-bold mb-2">Welcome to DRN Framework</h1>
    <p class="lead text-muted mb-3">A modern full-stack .NET framework with DDD architecture, React mounted islands, and a micro-frontends-ready foundation.</p>
</div>

<div data-js-hello-react-island
     data-versions="@versions"></div>

@section Scripts {
    <script src="buildwww/app/js/homeBehaviors.ts"></script>
}
