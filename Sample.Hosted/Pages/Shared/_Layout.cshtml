@{
    var headers = Context.Request.Headers;
    var isHtmxRequest = headers.ContainsKey("HX-Request") && headers["HX-Request"] == "true";

    Layout = "_LayoutBase";
    if (isHtmxRequest)
        Layout = "_LayoutBaseHtmx";

    var statusMessage = TempData[Get.TempDataKeys.StatusMessage] as string;
    var layoutOptions = ViewData[Get.ViewDataKeys.MainContentLayoutOptions] as MainContentLayoutOptions ?? new MainContentLayoutOptions();
    ViewData[Get.ViewDataKeys.Title] = layoutOptions.Title;
    
    //todo: add toolbar
    //todo: add debug store as an item to action bar
}

<partial name="_Navbar"/>

<div class="container-xxl d-flex flex-grow-1 p-0 bg-body bg-gradient" style="overflow: hidden; box-sizing: border-box; ">
    @if (ScopeContext.MFACompleted)
    {
        <partial name="_Sidebar"/>
    }

    <div data-toast-host class="position-relative d-flex flex-column flex-grow-1 mt-1" style="overflow-y: hidden; min-width: 0;">
        @if (ScopeContext.MFACompleted)
        {
            <partial name="_SubNavigation"/>
        }
        <aside aria-label="Main top content">
            @await RenderSectionAsync("MainTop", required: false)
        </aside>

        @if (!string.IsNullOrWhiteSpace(statusMessage))
        {
            <aside class="alert alert-success alert-dismissible mb-0 mt-1 mx-3" aria-label="Status message"
                   data-notification-status="@Guid.NewGuid().ToString("N")">
                <div role="alert">
                    <span data-notification-status-message>@statusMessage</span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </aside>
        }

        <!-- Main content -->
        <div class="d-flex pt-1 flex-grow-1 justify-content-center @(layoutOptions.CenterVertically ? "flex-column" : "") " style="overflow-y: auto;">
            <main id="drn-main-content" tabindex="-1" class="p-3 w-100 @(layoutOptions.ShouldExpandCard ? "d-flex flex-column flex-grow-1" : "") @(layoutOptions.CenterVertically ? "" : "h-100")">
                <div id="drn-problem-summary" class="d-none" hidden tabindex="-1"></div>
                <div class="row @(layoutOptions.CenterHorizontally ? "justify-content-center" : "") @(layoutOptions.ShouldExpandCard ? "flex-grow-1" : "")">
                    <div class="pb-2 @layoutOptions.CssColumnSize() @layoutOptions.CssTextAlignment()  @(layoutOptions.ShouldExpandCard ? "d-flex flex-column" : "")">
                        @if (layoutOptions.UsesCard)
                        {
                            <div class="card bg-light-subtle shadow @(layoutOptions.ShouldExpandCard ? "d-flex flex-grow-1" : "")">
                                @if (layoutOptions.HasTitle)
                                {
                                    @if (Get.Claim.Profile.SlimUi)
                                    {
                                        <h4 class="card-header">@layoutOptions.Title</h4>
                                    }
                                    else
                                    {
                                        <h3 class="card-header">@layoutOptions.Title</h3>
                                    }
                                }
                                @if (layoutOptions.Type == MainContentType.CardBody)
                                {
                                    <div class="card-body">@RenderBody()</div>
                                }
                                else
                                {
                                    @RenderBody()
                                }
                            </div>
                        }
                        else
                        {
                            @RenderBody()
                        }
                    </div>
                </div>
            </main>
        </div>

        <aside aria-label="Main bottom content">
            @await RenderSectionAsync("MainBottom", required: false)
        </aside>
    </div>
    @if (ScopeContext.MFACompleted)
    {
        <partial name="_SidebarActionbar"/>
    }
</div>

<partial name="_Footer"/>
<partial name="_NotificationShell"/>

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
