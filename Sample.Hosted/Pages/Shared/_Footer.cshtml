@using DRN.Framework.Hosting.Consent

@{
    var showCookieAlertBanner = !ConsentContext.ConsentCookie.Values.UserResponded;
}
@*
https://github.com/rstacruz/rsjs
https://rstacruz.github.io/rsjs/
*@
<footer class="border-top footer text-muted mt-auto" data-js-drn-footer
        data-preferences-cookie-name="@ConsentContext.CookieName"
        data-show-cookie-banner="@(showCookieAlertBanner ? "true" : "false")">
    <div class="container-xxl bg-light d-flex flex-wrap justify-content-between align-items-center gap-2 py-1">
        <div id="FooterLeft" class="flex-shrink-0">
            &copy; @DateTime.Now.Year - @ScopeContext.Settings.ApplicationName
        </div>
        <div id="FooterMiddle" class="order-3 order-lg-0 col-12 col-lg-auto">
            <nav class="footerNavbar d-flex align-items-center" data-js-footer-navbar>
                <ul class="nav">
                    <li class="nav-item"><a class="nav-link py-0" href="#">Privacy</a></li>
                    <li class="nav-item"><a class="nav-link py-0" href="#">Terms</a></li>
                    <li class="nav-item"><a class="nav-link py-0" href="#">Security</a></li>
                    <li class="nav-item"><a class="nav-link py-0" href="#">Contact</a></li>
                    <li class="nav-item"><a class="nav-link py-0" href="#">FAQ</a></li>
                </ul>
            </nav>
            <div class="preferenceCookieAlert d-none flex-wrap align-items-center gap-2" role="alert" data-js-cookie-alert>
                <span>We use cookies to enhance your experience. Check out our <a href="~/Privacy" class="alert-link">Privacy Policy</a>.</span>
                <button type="button" class="btn btn-primary btn-sm accept-policy me-2" aria-label="Accept" id="acceptPreferencesCookieBtn" data-js-accept-consent>
                    Accept
                </button>
                <button type="button" class="btn btn-secondary btn-sm reject-policy" aria-label="Reject" id="rejectPreferencesCookieBtn" data-js-reject-consent>
                    Reject
                </button>
            </div>
        </div>
        <div id="FooterRight">
            <div id="preferenceManagementContainer" class="d-flex align-items-center">
                <div class="dropup">
                    <!-- Main button for opening the cookie manager dropdown -->
                    <button class="btn btn-sm btn-light dropdown-toggle" type="button" id="PreferenceManager"
                            data-bs-toggle="dropdown" aria-expanded="false" aria-label="Preference Manager">
                        Preferences <i class="bi bi-sliders"></i>
                    </button>

                    <!-- Dropdown menu for cookie preferences -->
                    <ul class="dropdown-menu dropdown-menu-end p-3" aria-labelledby="PreferenceManager">
                        <!-- Analytics Cookies -->
                        <li class="dropdown-item" data-bs-toggle="tooltip" data-bs-placement="left" title="Allow us to analyze your activity for better service.">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="analyticsCookiesCheckBox" data-js-analytics-consent>
                                <label class="form-check-label" for="analyticsCookiesCheckBox">
                                    Analytics Cookies
                                </label>
                            </div>
                        </li>
                        <!-- Marketing Cookies -->
                        <li class="dropdown-item" data-bs-toggle="tooltip" data-bs-placement="left" title="Enable personalized marketing content.">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="marketingCookiesCheckBox" data-js-marketing-consent>
                                <label class="form-check-label" for="marketingCookiesCheckBox">
                                    Marketing Cookies
                                </label>
                            </div>
                        </li>
                        <li>
                            <hr class="dropdown-divider">
                        </li>
                        <li>
                            <button type="button" class="btn btn-sm btn-primary w-100" id="savePreferencesBtn" aria-label="Save Preferences" data-js-save-consent>
                                Save Preferences
                            </button>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</footer>
