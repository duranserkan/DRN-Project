<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Rider hosts generators on .NET 10 independently of the application's target. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- The supported compiler host floor is .NET 10, not .NET Framework. -->
    <NoWarn>$(NoWarn);RS1041</NoWarn>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <RuntimeIdentifier />
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.12.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
