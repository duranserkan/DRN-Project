<Project>
  <PropertyGroup>
    <_DrnSharedKernelPackagedAnalyzer>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../analyzers/dotnet/cs/DRN.Framework.SharedKernel.Analyzers.dll'))</_DrnSharedKernelPackagedAnalyzer>
    <_DrnSharedKernelPackagedCodeFixes>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../analyzers/dotnet/cs/DRN.Framework.SharedKernel.CodeFixes.dll'))</_DrnSharedKernelPackagedCodeFixes>
  </PropertyGroup>
  <ItemGroup>
    <Analyzer Remove="$(_DrnSharedKernelPackagedAnalyzer)" Condition="Exists('$(_DrnSharedKernelPackagedAnalyzer)')" />
    <Analyzer Include="$(_DrnSharedKernelPackagedAnalyzer)" Condition="Exists('$(_DrnSharedKernelPackagedAnalyzer)')" />
    <Analyzer Remove="$(_DrnSharedKernelPackagedCodeFixes)" Condition="Exists('$(_DrnSharedKernelPackagedCodeFixes)')" />
    <Analyzer Include="$(_DrnSharedKernelPackagedCodeFixes)" Condition="Exists('$(_DrnSharedKernelPackagedCodeFixes)')" />
    <CompilerVisibleProperty Include="IsTestProject" />
    <CompilerVisibleProperty Include="AllowMultipleAppIds" />
    <CompilerVisibleProperty Include="UseMicrosoftTestingPlatformRunner" />
  </ItemGroup>
</Project>
